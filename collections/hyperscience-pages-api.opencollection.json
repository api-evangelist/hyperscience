{
  "opencollection": "1.0.0",
  "info": {
    "name": "Hyperscience Audit Logs Pages API",
    "version": "5.0.0"
  },
  "request": {
    "auth": {
      "type": "oauth2",
      "flow": "client_credentials",
      "accessTokenUrl": "https://{server}.{company}.com/oauth/token",
      "credentials": {
        "clientId": "{{clientId}}",
        "clientSecret": "{{clientSecret}}"
      }
    }
  },
  "items": [
    {
      "info": {
        "name": "Pages",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List pages",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{server}.{company}.com/api/v5/pages"
          },
          "docs": "List pages"
        },
        {
          "info": {
            "name": "Retrieve page",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{server}.{company}.com/api/v5/pages/:page_id",
            "params": [
              {
                "name": "page_id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Retrieve page"
        }
      ]
    }
  ],
  "bundled": true
}