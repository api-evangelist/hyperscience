{
  "opencollection": "1.0.0",
  "info": {
    "name": "Hyperscience Audit Logs Flows API",
    "version": "5.0.0"
  },
  "request": {
    "auth": {
      "type": "oauth2",
      "flow": "client_credentials",
      "accessTokenUrl": "https://{server}.{company}.com/oauth/token",
      "credentials": {
        "clientId": "{{clientId}}",
        "clientSecret": "{{clientSecret}}"
      }
    }
  },
  "items": [
    {
      "info": {
        "name": "Flows",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Import / create flow",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://{server}.{company}.com/api/v5/flows",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Import / create flow"
        },
        {
          "info": {
            "name": "Retrieve flow",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{server}.{company}.com/api/v5/flows/:flow_id",
            "params": [
              {
                "name": "flow_id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Retrieve flow"
        }
      ]
    }
  ],
  "bundled": true
}